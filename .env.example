# Sentinel Station — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# Application
APP_NAME=Sentinel Station
APP_VERSION=1.0.0
DEBUG=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# LLM Provider (optional, opt-in)
# Supported: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# OIDC/Keycloak (required for production auth)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback

# Demo mode (local development only — REFUSED in production)
DEMO_MODE=true